### TRANSFERIR TURNO
POST http://localhost:5016/api/transfers
Content-Type: application/json

{
	"idTurn": 1,
	"turnsMovement": [
		{
			"turn": {
				"id": 2
			},
			"user": {
				"id": 1
			},
			"service": {
				"id": 3
			},
			"pointOfCare": {
				"id": 1
			},
			"branch": {
				"id": 1
			},
			"state": 1,
			"active": 1,
			"transfer": true
		},
		{
			"turn": {
				"id": 1
			},
			"user": {
				"id": 1,
				"user": "andres",
				"lastName": "sanchez",
				"name": "andres"
			},
			"service": {
				"id": 1
			},
			"pointOfCare": {
				"id": 1
			},
			"branch": {
				"id": 1
			},
			"state": 1,
			"active": 1,
			"transfer": false
		}
	],
	"user": {
		"id": 1,
		"user": "andres",
		"lastName": "sanchez",
		"name": "andres"
	}
}	


